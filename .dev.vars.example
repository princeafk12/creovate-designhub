# Cloudflare Pages Functions development values.
# Copy to .dev.vars locally and fill with test values. Never commit .dev.vars.
OWNER_EMAIL=olanitealabij2023@gmail.com
OWNER_NOTIFICATION_EMAIL=olanitealabij2023@gmail.com
# Legacy admin password-reset variables; keep only if that endpoint is retained.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
RESEND_API_KEY=
EMAIL_FROM=
# Validator uses public World Bank indicators and Gemini only, without paid search grounding.
APP_BASE_URL=http://localhost:8788
# Set true only after the owner completes Flutterwave test checkout and webhook verification.
PAYMENTS_READY=false
# Promo Studio remains fail-closed until the owner completes provider and payment testing.
FIREBASE_PROJECT_ID=creovate-designhub
FIREBASE_WEB_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
AI_PROVIDER=gemini
# Keep unset/false for free-only Gemini operation. Set true only after approving and configuring a paid alternate provider.
# AI_PAID_PROVIDER_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
# Optional future provider; never set this in place of Gemini unless deliberately switching.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Shared Business Tools and Validator master switches.
PROMO_STUDIO_ENABLED=false
GENERATION_PAUSED=true
VALIDATOR_PAUSED=false
AI_DAILY_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=10
